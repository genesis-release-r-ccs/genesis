[INPUT]
grotopfile            = ../../../build/cg_systems/top/tdp43_1000.top
grocrdfile            = ../../../build/cg_systems/crd/tdp43_1000.gro

[ENERGY]
forcefield            = RESIDCG
electrostatic         = CUTOFF

cg_cutoffdist_126     = 20.0
cg_cutoffdist_ele     = 35.0
cg_pairlistdist_126   = 23.0
cg_pairlistdist_ele   = 38.0
cg_sol_ionic_strength = 0.15
cg_IDR_HPS_epsilon    = 0.2

[DYNAMICS]
integrator            = VVER
nsteps                = 20
timestep              = 0.010
eneout_period         = 2
nbupdate_period       = 10
stoptr_period         = 10

[CONSTRAINTS]
rigid_bond            = NO 

[ENSEMBLE]
ensemble              = NVE
tpcontrol             = NO
temperature           = 0

[BOUNDARY]
type                  = PBC   
box_size_x            = 1000.0
box_size_y            = 1000.0
box_size_z            = 1500.0
