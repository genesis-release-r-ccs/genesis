[INPUT]
grotopfile            = ../../../build/cg_systems/top/popc.top
grocrdfile            = ../../../build/cg_systems/crd/popc.gro
rstfile               = ../../../build/cg_systems/rst/popc.rst

[ENERGY]
forcefield            = RESIDCG
electrostatic         = CUTOFF
cg_sol_temperature    = 303.15
cg_sol_ionic_strength = 0.15

[DYNAMICS]
integrator            = VVER_CG
nsteps                = 100
timestep              = 0.010
eneout_period         = 20
stoptr_period         = 10
nbupdate_period       = 10

[CONSTRAINTS]
rigid_bond            = NO

[ENSEMBLE]
ensemble              = NPT
tpcontrol             = LANGEVIN
temperature           = 303.15
pressure              = 0.00
gamma_t               = 0.01
gamma_p               = 0.01
isotropy              = Z-FIXED-SEMI-ISO

[BOUNDARY]
type                  = PBC

